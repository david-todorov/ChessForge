<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>


<VBox xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.controllers.TwoPlayerController"
      alignment="CENTER" spacing="25"
      prefWidth="900" prefHeight="620"
      style="
         -fx-background-color: linear-gradient(to bottom right, #f9f7f1, #e0d7c6, #cdbfae);
         -fx-padding: 50;
         -fx-background-radius: 20;
         -fx-border-radius: 20;
         -fx-border-color: #b3a693;
         -fx-border-width: 3;
         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0.1, 0, 4);">
    <Label text="Two Player Mode"
           style="-fx-font-size: 28px;
                  -fx-font-family: 'Segoe UI Semibold';
                  -fx-text-fill: #4b3f35;" />

    <HBox alignment="CENTER" spacing="20.0">
        <!-- Dead pieces container for Player 1 -->
        <VBox spacing="15" alignment="TOP_CENTER"
              prefWidth="220"
              style="-fx-background-color: linear-gradient(to bottom, #d3cbb7, #7a7a7a);
             -fx-border-color: #5a3e1b;
             -fx-border-width: 2px;
             -fx-border-radius: 12;
             -fx-background-radius: 12;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 6, 0, 0, 0);
             -fx-padding: 20;">

            <Label text="Player 1"
                   style="-fx-font-size: 18px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #3e2f1c;
                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 12, 0.5, 0, 3);" />

            <FlowPane fx:id="player1DeadPiecesPane"
                      hgap="6" vgap="6" prefWrapLength="180"
                      style="-fx-background-color: transparent;
                     -fx-padding: 5;" />
        </VBox>
        <VBox spacing="10" alignment="CENTER">
            <!-- top labels A to H -->

            <HBox alignment="CENTER_LEFT" spacing="44.5" style="-fx-padding: 0 0 0 50;">
                <Label text="A" style="-fx-font-weight: bold; -fx-font-size: 19px;" rotate="180"/>
                <Label text="B" style="-fx-font-weight: bold; -fx-font-size: 19px;" rotate="180"/>
                <Label text="C" style="-fx-font-weight: bold; -fx-font-size: 19px;" rotate="180"/>
                <Label text="D" style="-fx-font-weight: bold; -fx-font-size: 19px;" rotate="180"/>
                <Label text="E" style="-fx-font-weight: bold; -fx-font-size: 19px;" rotate="180"/>
                <Label text="F" style="-fx-font-weight: bold; -fx-font-size: 19px;" rotate="180"/>
                <Label text="G" style="-fx-font-weight: bold; -fx-font-size: 19px;" rotate="180"/>
                <Label text="H" style="-fx-font-weight: bold; -fx-font-size: 19px;" rotate="180"/>
            </HBox>


            <!-- Board with left-side 1–8 labels -->
            <HBox spacing="10" alignment="CENTER">
                <VBox spacing="32.5" alignment="CENTER_RIGHT">
                    <Label text="8" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="7" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="6" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="5" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="4" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="3" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="2" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="1" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                </VBox>

                <!-- Chessboard GridPane -->
                <GridPane fx:id="chessBoard" gridLinesVisible="true"
                          prefWidth="480" prefHeight="480"
                          style="-fx-max-width: 480px; -fx-max-height: 480px;">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="12.5"/>
                        <ColumnConstraints percentWidth="12.5"/>
                        <ColumnConstraints percentWidth="12.5"/>
                        <ColumnConstraints percentWidth="12.5"/>
                        <ColumnConstraints percentWidth="12.5"/>
                        <ColumnConstraints percentWidth="12.5"/>
                        <ColumnConstraints percentWidth="12.5"/>
                        <ColumnConstraints percentWidth="12.5"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints percentHeight="12.5"/>
                        <RowConstraints percentHeight="12.5"/>
                        <RowConstraints percentHeight="12.5"/>
                        <RowConstraints percentHeight="12.5"/>
                        <RowConstraints percentHeight="12.5"/>
                        <RowConstraints percentHeight="12.5"/>
                        <RowConstraints percentHeight="12.5"/>
                        <RowConstraints percentHeight="12.5"/>
                    </rowConstraints>

                    <!-- 64 Squares -->
                    <!-- Each square is a StackPane with background color: light or dark -->
                    <!-- You can adjust colors with CSS later if desired -->
                    <!-- Row 0 -->
                    <!-- Row 0 (a8 to h8) -->
                    <StackPane GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-background-color: #f0d9b5;"><ImageView fx:id="a8" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-background-color: #b58863;"><ImageView fx:id="b8" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-background-color: #d8d0c0;"><ImageView fx:id="c8" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-background-color: #808080;"><ImageView fx:id="d8" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="0" GridPane.columnIndex="4" style="-fx-background-color: #d8d0c0;"><ImageView fx:id="e8" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="0" GridPane.columnIndex="5" style="-fx-background-color: #808080;"><ImageView fx:id="f8" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="0" GridPane.columnIndex="6" style="-fx-background-color: #d8d0c0;"><ImageView fx:id="g8" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="0" GridPane.columnIndex="7" style="-fx-background-color: #808080;"><ImageView fx:id="h8" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>

                    <!-- Row 1 (a7 to h7) -->
                    <StackPane GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-background-color: #808080  ;"><ImageView fx:id="a7" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-background-color: #d8d0c0;"><ImageView fx:id="b7" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-background-color: #808080  ;"><ImageView fx:id="c7" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="1" GridPane.columnIndex="3" style="-fx-background-color: #d8d0c0;"><ImageView fx:id="d7" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="1" GridPane.columnIndex="4" style="-fx-background-color: #808080  ;"><ImageView fx:id="e7" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="1" GridPane.columnIndex="5" style="-fx-background-color: #d8d0c0;"><ImageView fx:id="f7" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="1" GridPane.columnIndex="6" style="-fx-background-color: #808080  ;"><ImageView fx:id="g7" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="1" GridPane.columnIndex="7" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="h7" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>

                    <!-- Row 2 (a6 to h6) -->
                    <StackPane GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="a6" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-background-color: #808080  ;"><ImageView fx:id="b6" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="2" GridPane.columnIndex="2" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="c6" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="2" GridPane.columnIndex="3" style="-fx-background-color: #808080  ;"><ImageView fx:id="d6" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="2" GridPane.columnIndex="4" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="e6" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="2" GridPane.columnIndex="5" style="-fx-background-color: #808080  ;"><ImageView fx:id="f6" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="2" GridPane.columnIndex="6" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="g6" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="2" GridPane.columnIndex="7" style="-fx-background-color: #808080  ;"><ImageView fx:id="h6" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>

                    <!-- Row 3 (a5 to h5) -->
                    <StackPane GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-background-color: #808080  ;"><ImageView fx:id="a5" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="b5" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="3" GridPane.columnIndex="2" style="-fx-background-color: #808080  ;"><ImageView fx:id="c5" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="3" GridPane.columnIndex="3" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="d5" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="3" GridPane.columnIndex="4" style="-fx-background-color: #808080  ;"><ImageView fx:id="e5" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="3" GridPane.columnIndex="5" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="f5" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="3" GridPane.columnIndex="6" style="-fx-background-color: #808080  ;"><ImageView fx:id="g5" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="3" GridPane.columnIndex="7" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="h5" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>

                    <!-- Row 4 (a4 to h4) -->
                    <StackPane GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="a4" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-background-color: #808080  ;"><ImageView fx:id="b4" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="4" GridPane.columnIndex="2" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="c4" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="4" GridPane.columnIndex="3" style="-fx-background-color: #808080  ;"><ImageView fx:id="d4" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="4" GridPane.columnIndex="4" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="e4" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="4" GridPane.columnIndex="5" style="-fx-background-color: #808080  ;"><ImageView fx:id="f4" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="4" GridPane.columnIndex="6" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="g4" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="4" GridPane.columnIndex="7" style="-fx-background-color: #808080  ;"><ImageView fx:id="h4" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>

                    <!-- Row 5 (a3 to h3) -->
                    <StackPane GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-background-color: #808080  ;"><ImageView fx:id="a3" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="b3" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="5" GridPane.columnIndex="2" style="-fx-background-color: #808080  ;"><ImageView fx:id="c3" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="5" GridPane.columnIndex="3" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="d3" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="5" GridPane.columnIndex="4" style="-fx-background-color: #808080  ;"><ImageView fx:id="e3" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="5" GridPane.columnIndex="5" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="f3" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="5" GridPane.columnIndex="6" style="-fx-background-color: #808080  ;"><ImageView fx:id="g3" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="5" GridPane.columnIndex="7" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="h3" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>

                    <!-- Row 6 (a2 to h2) -->
                    <StackPane GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="a2" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="6" GridPane.columnIndex="1" style="-fx-background-color: #808080  ;"><ImageView fx:id="b2" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="6" GridPane.columnIndex="2" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="c2" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="6" GridPane.columnIndex="3" style="-fx-background-color: #808080  ;"><ImageView fx:id="d2" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="6" GridPane.columnIndex="4" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="e2" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="6" GridPane.columnIndex="5" style="-fx-background-color: #808080  ;"><ImageView fx:id="f2" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="6" GridPane.columnIndex="6" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="g2" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="6" GridPane.columnIndex="7" style="-fx-background-color: #808080  ;"><ImageView fx:id="h2" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>

                    <!-- Row 7 (a1 to h1) -->
                    <StackPane GridPane.rowIndex="7" GridPane.columnIndex="0" style="-fx-background-color: #808080  ;"><ImageView fx:id="a1" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="7" GridPane.columnIndex="1" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="b1" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="7" GridPane.columnIndex="2" style="-fx-background-color: #808080  ;"><ImageView fx:id="c1" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="7" GridPane.columnIndex="3" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="d1" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="7" GridPane.columnIndex="4" style="-fx-background-color: #808080  ;"><ImageView fx:id="e1" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="7" GridPane.columnIndex="5" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="f1" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="7" GridPane.columnIndex="6" style="-fx-background-color: #808080  ;"><ImageView fx:id="g1" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>
                    <StackPane GridPane.rowIndex="7" GridPane.columnIndex="7" style="-fx-background-color: #d8d0c0 ;"><ImageView fx:id="h1" fitWidth="60" fitHeight="60" preserveRatio="true"/></StackPane>

                </GridPane>
                <!-- Right side of  1 to 8 -->
                <VBox spacing="32.5" alignment="CENTER_LEFT" rotate="180">
                    <Label text="1" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="2" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="3" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="4" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="5" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="6" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="7" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                    <Label text="8" style="-fx-font-weight: bold; -fx-font-size: 19px;"/>
                </VBox>
            </HBox>
            <!-- bottom side of  a to h -->
            <HBox alignment="CENTER_LEFT" spacing="44.5" style="-fx-padding: 0 0 0 50;">
                <Label text="A" style="-fx-font-weight: bold; -fx-font-size: 19px;" />
                <Label text="B" style="-fx-font-weight: bold; -fx-font-size: 19px;" />
                <Label text="C" style="-fx-font-weight: bold; -fx-font-size: 19px;" />
                <Label text="D" style="-fx-font-weight: bold; -fx-font-size: 19px;" />
                <Label text="E" style="-fx-font-weight: bold; -fx-font-size: 19px;" />
                <Label text="F" style="-fx-font-weight: bold; -fx-font-size: 19px;" />
                <Label text="G" style="-fx-font-weight: bold; -fx-font-size: 19px;" />
                <Label text="H" style="-fx-font-weight: bold; -fx-font-size: 19px;" />
            </HBox>

        </VBox>
        <!-- Dead pieces container for Player 2 -->
        <VBox spacing="15" alignment="TOP_CENTER"
              prefWidth="220"
              style="-fx-background-color: linear-gradient(to bottom, #d3cbb7, #7a7a7a);
             -fx-border-color: #5a3e1b;
             -fx-border-width: 2px;
             -fx-border-radius: 12;
             -fx-background-radius: 12;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 8, 0.3, 2, 2);
             -fx-padding: 20;">

            <Label text="Player2"
                   alignment="CENTER"
                   style="-fx-font-size: 18px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #3e2f1c;
                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 12, 0.5, 0, 3);" />

            <FlowPane fx:id="player2DeadPiecesPane"
                      hgap="6" vgap="6" prefWrapLength="180"
                      style="-fx-background-color: transparent;
                     -fx-padding: 5;" />
        </VBox>

    </HBox>

    <!--this is for timer -->
    <HBox alignment="CENTER" spacing="40">

        <!-- Left Timer (Player 1) -->
        <VBox alignment="CENTER" spacing="18"
              style="
         -fx-background-color: linear-gradient(to bottom, #fefefe, #f4f1ec);
         -fx-padding: 30;
         -fx-background-radius: 20;
         -fx-border-radius: 20;
         -fx-border-color: #d8cfc4;
         -fx-border-width: 2;
         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0.2, 0, 6);">

            <Label text="PLAYER 1"
                   style="-fx-font-size: 26px;
                  -fx-font-family: 'Segoe UI Bold';
                  -fx-text-fill: #3c2f23;
                  -fx-letter-spacing: 1.2px;" />

            <Label fx:id="player1TimerLabel" text="05:00"
                   style="-fx-font-size: 30px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #5a4331;
                  -fx-background-color: #ede7df;
                  -fx-padding: 8 16;
                  -fx-background-radius: 12;" />

            <Button fx:id="endTurnButton" text="End Turn" onAction="#onEndTurn"
                    style="
                -fx-font-size: 18px;
                -fx-font-weight: bold;
                -fx-text-fill: white;
                -fx-background-color: linear-gradient(to right, #7b6652, #a58c75);
                -fx-background-radius: 12;
                -fx-padding: 8 20 8 20;
                -fx-cursor: hand;
                -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 5, 0, 0, 2);"/>
        </VBox>



        <!-- Right Timer (Player 2) -->
        <VBox alignment="CENTER" spacing="18"
              style="
         -fx-background-color: linear-gradient(to bottom, #fefefe, #f4f1ec);
         -fx-padding: 30;
         -fx-background-radius: 20;
         -fx-border-radius: 20;
         -fx-border-color: #d8cfc4;
         -fx-border-width: 2;
         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0.2, 0, 6);">

            <Label text="PLAYER 2"
                   style="-fx-font-size: 26px;
                  -fx-font-family: 'Segoe UI Bold';
                  -fx-text-fill: #3c2f23;
                  -fx-letter-spacing: 1.2px;" />

            <Label fx:id="player2TimerLabel" text="05:00"
                   style="-fx-font-size: 30px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #5a4331;
                  -fx-background-color: #ede7df;
                  -fx-padding: 8 16;
                  -fx-background-radius: 12;" />

            <Button fx:id="endButton" text="End Turn" onAction="#onEndTurn"
                    style="
                -fx-font-size: 18px;
                -fx-font-weight: bold;
                -fx-text-fill: white;
                -fx-background-color: linear-gradient(to right, #7b6652, #a58c75);
                -fx-background-radius: 12;
                -fx-padding: 8 20 8 20;
                -fx-cursor: hand;
                -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 5, 0, 0, 2);"/>
        </VBox>


    </HBox>



    <!-- Control Buttons -->
    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="startButton" text="Start Game"
                style="-fx-padding: 8 20 8 20; -fx-min-width: 120;" />

        <Button fx:id="resetButton" text="Reset Board"
                style="-fx-padding: 8 20 8 20; -fx-min-width: 120;" />

        <Button fx:id="backButton" text="Back to Main Menu"
                onAction="#onBackToMainMenu"
                style="-fx-padding: 8 20 8 20; -fx-min-width: 160;" />

        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>
    </HBox>
</VBox>